# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# =====================================================
# CONTENT-OS OUTPUT - All generated files (per session)
# =====================================================

# Session recordings (input files from camera/screen)
# EXCLUDE: raw footage (*.mp4)
# KEEP: session metadata (session.json)
data/recordings/*/
!data/recordings/*/session.json

# All pipeline output
output/*/

# Keep directory structure with .gitkeep (empty dirs only)
!data/recordings/.gitkeep
!data/footage/.gitkeep
!output/proxies/.gitkeep
!output/audio/.gitkeep
!output/transcripts/.gitkeep
!output/analysis/.gitkeep
!output/cutmaps/.gitkeep
!output/exports/.gitkeep
!output/thumbnails/.gitkeep
!output/briefs/.gitkeep

# =====================================================
# CONFIG - Keep these (not results)
# =====================================================

# Config files - KEEP these (default configs)
config/*.json
!config/settings.example.json
!config/filler_words_es.txt

# Remotion presets - KEEP these (not results)
remotion/config/presets/*.json
!remotion/config/presets/test_preset.json

# =====================================================
# CUSTOM EXTENSION - Results marked with this extension
# are excluded, keeping default configs readable
# =====================================================
*.content-os.json

# =====================================================
# TEST FOOTAGE - Large binary files
# =====================================================
data/footage/*.mp4
data/footage/*.mov
!data/footage/.gitkeep

# =====================================================
# NODE / JS
# =====================================================
node_modules/
vendor/

# Remotion build artifacts
remotion/build/
remotion/bin/
remotion/public/
remotion/static/

# Remotion test files
remotion/test_*.json
remotion/input-props.json
remotion/input_video.mp4

# =====================================================
# TEMP / DEBUG
# =====================================================
temp/
*.wav
*.gif

# Workspace demo artifacts
workspace_demo/*/
!workspace_demo/.gitkeep

# OpenCode CLI config
session-mvp.json
