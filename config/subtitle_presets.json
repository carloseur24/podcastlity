        },
        "stagger_ms": 80
      },
      "style": {
        "font_family": "Poppins",
        "font_size": 32,
        "font_weight": 600,
        "text_color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 2,
