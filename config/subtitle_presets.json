{
  "presets": {
    "kinetic_pop": {
      "name": "Kinetic Pop-in",
      "description": "Trending TikTok word-by-word pop animation with spring bounce",
      "engine": "remotion",
      "animation": {
        "type": "word_by_word",
        "entrance": "pop_in",
        "timing": "sync_to_speech",
        "combine_tokens_ms": 800,
        "spring": {
          "damping": 12,
          "stiffness": 180,
          "mass": 1
        },
        "stagger_ms": 50
      },
      "style": {
        "font_family": "Inter",
        "font_size": 36,
        "font_weight": 700,
        "text_color": "#FFFFFF",
        "stroke_color": "#000000",
        "stroke_width": 2,
        "background": "rounded_box",
        "bg_color": "#000000",
        "bg_opacity": 0.7,
        "padding_x": 24,
        "padding_y": 16,
        "border_radius": 12
      },
      "position": {
        "anchor": "bottom_center",
        "y_offset": 120
      },
      "highlight": {
        "enabled": true,
        "color": "#FFD700",
        "words": ["important", "key", "main", "essential", "critical"]
      }
    },
    "kinetic_slide": {
      "name": "Kinetic Slide",
