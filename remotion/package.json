{
  "name": "mvp-editing-pipeline-remotion",
  "version": "1.0.0",
  "description": "Remotion components for kinetic subtitle animations",
  "main": "index.tsx",
  "dependencies": {
    "@remotion/captions": "4.0.443",
    "@remotion/cli": "4.0.443",
    "@remotion/fonts": "^4.0.445",
    "@remotion/media": "4.0.443",
    "@remotion/renderer": "4.0.443",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.443"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "remotion bundle index.tsx Main --out-dir build",
    "preview": "remotion studio",
    "render": "remotion render index.tsx Main",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
